DirectoryIndex index.html
ErrorDocument 404 /404.html

# WordPress slugged the 2019 term "2019-2"; we serve it as /2019/ and send the
# old paths on, so links already out in the world still land on the right page.
RedirectMatch 301 ^/2019-2/(.+)$ /2019/$1
RedirectMatch 301 ^/2019-2/?$ /#2019

# Soft Computing was briefly filed under Spring 2026 before it moved to Fall 2026.
RedirectMatch 301 ^/spring-2026/soft-computing/?$ /fall-2026/soft-computing/

# Terms had no page of their own: send each to its section of the course list.
RedirectMatch 301 ^/(fall-2026|spring-2026|fall-2025|spring-2025|fall-2024|2019)/?$ /#$1

# Unfinished WordPress drafts, deleted in the rebuild.
RedirectMatch 301 ^/(profile|students|research-projects|publication|abut-me)/?$ /

# deploy.sh's rsync excludes .git, but CLAUDE.md calls this the second line of
# defence and it was missing: a served .git directory hands out the whole history.
RedirectMatch 404 ^/\.git
RedirectMatch 404 ^/deploy\.sh$

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML is the only thing that changes without its URL changing, so it always
  # revalidates. Everything below is either fingerprinted or effectively frozen.
  ExpiresByType text/html                 "access plus 0 seconds"

  # style.css is requested as style.css?v=<sha1>. The hash IS the cache key --
  # see the warning in CLAUDE.md before touching this number.
  ExpiresByType text/css                  "access plus 1 year"

  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"

  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"

  # search.json is read by the search box on every page load.
  ExpiresByType application/json          "access plus 1 day"

  # Lecture files: replaced by uploading a new name, never edited in place.
  ExpiresByType application/pdf           "access plus 1 year"
  ExpiresByType application/vnd.openxmlformats-officedocument.presentationml.presentation "access plus 1 year"
  ExpiresByType application/vnd.openxmlformats-officedocument.wordprocessingml.document   "access plus 1 year"
  ExpiresByType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet         "access plus 1 year"
  ExpiresByType application/vnd.ms-powerpoint  "access plus 1 year"
  ExpiresByType application/msword             "access plus 1 year"
  ExpiresByType application/zip                "access plus 1 year"

  ExpiresDefault                          "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  # immutable stops the browser revalidating on reload; safe only because every
  # one of these is replaced by publishing a NEW url, never by editing in place.
  <FilesMatch "\.(woff2|woff|jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
                                application/json application/javascript image/svg+xml
</IfModule>
